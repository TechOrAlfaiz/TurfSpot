# ==============================================================================
# TurfSpot Backend Environment Configuration Template
# ==============================================================================
# IMPORTANT: Copy this file to .env in the server directory and provide your
# real production credentials. Never commit secrets or .env files to Git repository.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Core Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=1234
CLIENT_ORIGIN=http://localhost:5173
PAYMENT_PROVIDER=mock
PAYMENT_HOLD_MINUTES=10

# ------------------------------------------------------------------------------
# 2. Database Connection (MongoDB)
# ------------------------------------------------------------------------------
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster0.mongodb.net/turfspot?retryWrites=true&w=majority
# Example Local URI: mongodb://localhost:27017/turfspot
MONGO_URI=mongodb+srv://<db_user>:<db_password>@cluster0.example.mongodb.net/turfspot?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. Authentication & Security (JWT)
# ------------------------------------------------------------------------------
# Generate a strong 64-character hex secret (e.g., using `openssl rand -hex 32`)
JWT_SECRET=your_production_jwt_secret_64_characters_long_replace_this

# ------------------------------------------------------------------------------
# 4. Razorpay Payment Gateway
# ------------------------------------------------------------------------------
# Obtain from Razorpay Dashboard -> Settings -> API Keys & Webhooks
RAZORPAY_KEY_ID=rzp_live_your_actual_razorpay_key_id
RAZORPAY_KEY_SECRET=your_actual_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_actual_razorpay_webhook_secret

# ------------------------------------------------------------------------------
# 5. WhatsApp Business Cloud API (Meta for Developers)
# ------------------------------------------------------------------------------
# Graph API endpoint: https://graph.facebook.com/v19.0/{WHATSAPP_PHONE_NUMBER_ID}/messages
# Obtain from Meta Developers Portal -> WhatsApp -> API Setup
WHATSAPP_ACCESS_TOKEN=EAAG...your_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=100000000000000
WHATSAPP_BUSINESS_ACCOUNT_ID=200000000000000

# ------------------------------------------------------------------------------
# 6. Email Service (Nodemailer / SMTP / Gmail App Password)
# ------------------------------------------------------------------------------
EMAIL_SERVICE=gmail
EMAIL=notifications@yourdomain.com
PASSWORD=your_16_char_app_password_here

# ------------------------------------------------------------------------------
# 7. Cloud Storage (Cloudinary - for Turf Images & Profile Avatars)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 8. Google Maps & Geocoding API (Optional Backend Geolocation)
# ------------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=AIzaSy...your_google_maps_backend_key_here
# Google Places API Key (Optional; if omitted, backend automatically falls back to OpenStreetMap Overpass API)
GOOGLE_PLACES_API_KEY=AIzaSy...your_google_places_api_key_here

# ------------------------------------------------------------------------------
# 9. Platform Governance (Super Admin Credentials)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=YourStrongAdminPassword2025!

